  translation -50.000 30.000 0.02
  rotation 0 0 1 -1.57080
  name "left"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  length 60.000
}
CurvedRoadSegment {
  translation -30.000 -30.000 0.02
  rotation 0 0 1 3.14159
  name "corner_bl"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  curvatureRadius 20.0
  subdivision 48
}
TeslaModel3 {
  translation 0.000 -50.000 0.400134
  rotation 0 0 1 0
  controller "<extern>"
  sensorsSlotFront [
    Camera {
      # Intel RealSense D435 RGB sensor: 69 deg horizontal FOV (1.204 rad),
      # 1280x720 -- see README for the full spec table and the approximations
      # made (co-located with the depth sensor, no lens distortion).
      translation -2.12 0 1.115
      rotation 0 1 0 0.157
      name "camera"
      fieldOfView 1.204277
      width 1280
      height 720
      recognition Recognition {
        occlusion 0
        frameThickness 0
        segmentation TRUE
      }
    }
    GPS {
      name "gps"
    }
    RangeFinder {
      # Intel RealSense D435 depth sensor: 87 deg horizontal FOV (1.518 rad),
      # 848x480, range 0.105-10 m (datasheet gives 0.105 m as the Min-Z at this
      # resolution, and 0.3-3 m as the "ideal" accurate range; 10 m is the
      # commonly cited usable max at reduced accuracy).
      translation -2.12 0 1.115
      rotation 0 1 0 0.157
      name "range_finder"
      fieldOfView 1.518436
      width 848
      height 480
      minRange 0.105
      maxRange 10
    }
    Accelerometer {
      # D435i's IMU is a Bosch BMI055 (confirmed from Intel's own
      # documentation), co-located with the camera/depth module. Left at
      # Webots' default noise-free, unbounded-range behaviour -- if you need
      # the BMI055's actual full-scale range/noise modelled, commonly-cited
      # defaults are +/-4g accel and +/-1000 deg/s gyro, but I could not
      # verify current firmware settings against Bosch's or Intel's spec
      # pages from here.
      translation -2.12 0 1.115
      rotation 0 1 0 0.157
      name "accelerometer"
    }
    Gyro {
      translation -2.12 0 1.115
      rotation 0 1 0 0.157
      name "gyro"
    }
  ]
}

