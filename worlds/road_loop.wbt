WorldInfo {
  info [
    "Simulation of Tesla Model 3 that exposes the AckermannDrive ROS 2 interface."
  ]
  title "ROS2 simulation of the Tesla car"
  ERP 0.6
  basicTimeStep 10
  lineScale 1
  contactProperties [
    ContactProperties {
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
    ContactProperties {
      material2 "TeslaModel3Wheel"
      coulombFriction [
        8
      ]
      softCFM 1e-05
      bumpSound ""
      rollSound ""
      slideSound ""
    }
  ]
}
Viewpoint {
  orientation 0.08268451863488442 -0.008282374566606533 -0.9965413552129464 3.340616867722656
  position 51.670031498239545 41.288011070033996 5.128037630741435
  near 1
  follow "vehicle"
  followSmoothness 0
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Fog {
  color 0.38 0.35 0.32
  visibilityRange 1000
}
DEF GROUND Solid {
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.8 0.8
        baseColorMap ImageTexture {
          url [
            "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/vehicles/worlds/textures/ground.jpg"
          ]
        }
        roughness 0.5
        metalness 0
        textureTransform TextureTransform {
          scale 500 500
        }
      }
      geometry DEF GROUND_PLANE Plane {
        size 2000 2000
      }
    }
  ]
  boundingObject USE GROUND_PLANE
  locked TRUE
}
StraightRoadSegment {
  translation -30.000 -50.000 0.02
  rotation 0 0 1 0.00000
  name "bottom"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  length 60.000
}
CurvedRoadSegment {
  translation 30.000 -30.000 0.02
  rotation 0 0 1 -1.57080
  name "corner_br"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  curvatureRadius 20.0
  subdivision 48
}
StraightRoadSegment {
  translation 50.000 -30.000 0.02
  rotation 0 0 1 1.57080
  name "right"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  length 60.000
}
CurvedRoadSegment {
  translation 30.000 30.000 0.02
  rotation 0 0 1 0.00000
  name "corner_tr"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  curvatureRadius 20.0
  subdivision 48
}
StraightRoadSegment {
  translation 30.000 50.000 0.02
  rotation 0 0 1 3.14159
  name "top"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  length 60.000
}
CurvedRoadSegment {
  translation -30.000 30.000 0.02
  rotation 0 0 1 1.57080
  name "corner_tl"
  width 7.0
  numberOfLanes 2
  numberOfForwardLanes 1
  curvatureRadius 20.0
